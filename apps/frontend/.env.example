# URL backend NestJS. Default sesuai PORT di apps/backend/.env.example (3000).
VITE_API_URL=http://localhost:3000

# Token publik Mapbox (gratis, signup di mapbox.com -> Access tokens).
# Tanpa ini CityMap nampilin pesan "Peta belum aktif" alih-alih peta 3D.
VITE_MAPBOX_TOKEN=

# JEK-44 — dipisah koma, cuma buat GATE UI. Penegakan sesungguhnya ada di
# backend (PETUGAS_PANEL_EMAILS, apps/backend/.env), samain isinya.
VITE_PETUGAS_PANEL_EMAILS=
