DATABASE_URL="postgresql://postgres:postgres@localhost:5432/antrean_kota"
PORT=3000

JWT_ACCESS_SECRET="ganti-dengan-secret-acak"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-lain"
JWT_REFRESH_EXPIRES_IN="7d"

# Pisah koma kalau lebih dari satu domain (tambah domain produksi frontend di sini
# begitu JEK-56 final). Default kalau kosong: http://localhost:5173
CORS_ORIGINS="http://localhost:5173"

# Dipakai asisten tanya jawab antrean (JEK-29). Ambil gratis di console.groq.com
GROQ_API_KEY="ganti-dengan-api-key-groq"

# Cloudflare R2 (S3-compatible). Endpoint format:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Dipakai oleh endpoint presigned URL (JEK-22) — lihat JEK-53.
S3_ENDPOINT="https://ganti-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="antrean-kota-photos"
S3_ACCESS_KEY_ID="ganti-dengan-access-key-id"
S3_SECRET_ACCESS_KEY="ganti-dengan-secret-access-key"
# URL publik bucket (lewat custom domain / CDN Cloudflare di JEK-54, atau r2.dev sementara)
S3_PUBLIC_URL="https://ganti-dengan-public-url"

# JEK-44 — cuma akun dengan email persis ini (dipisah koma) yang boleh akses
# Panel Petugas & ubah status laporan, meskipun peran-nya udah 'petugas'.
PETUGAS_PANEL_EMAILS="ganti-dengan-email-petugas@example.com"